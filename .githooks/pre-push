#!/bin/sh
# Git Pre-Push Hook for VoiceClonerWebDemo
echo "========================================================="
echo "🔍 [PRE-PUSH HOOK] Running VoiceClonerWebDemo pytest suite..."
echo "========================================================="

python -m pytest tests/ -v
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [PRE-PUSH HOOK FAILED] Tests failed in VoiceClonerWebDemo!"
    echo "   Please fix failing tests before pushing."
    echo "========================================================="
    exit 1
fi

echo ""
echo "✅ [PRE-PUSH HOOK PASSED] All VoiceClonerWebDemo tests passed."
echo "========================================================="
exit 0
